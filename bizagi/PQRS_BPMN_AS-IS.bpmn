<?xml version="1.0" ?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ASIS" targetNamespace="http://pqrs.villaserena.example/bpmn" name="Proceso AS-IS: gestión manual de PQRS (alcaldía ficticia de Villa Serena)">
  <bpmn:collaboration id="Collab_ASIS">
    <bpmn:participant id="Part_Ciu" name="Ciudadano" processRef="Proc_Ciu"/>
    <bpmn:participant id="Part_Alc" name="Alcaldía de Villa Serena" processRef="Proc_Alc"/>
    <bpmn:messageFlow id="MF10" sourceRef="TA01" targetRef="TA05"/>
    <bpmn:messageFlow id="MF11" sourceRef="TA02" targetRef="TA05"/>
    <bpmn:messageFlow id="MF12" sourceRef="TA03" targetRef="TA04"/>
    <bpmn:messageFlow id="MF28" sourceRef="TA13" targetRef="TA15"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_Ciu" isExecutable="false" name="Ciudadano">
    <bpmn:startEvent id="S_c" name="Necesita presentar una PQRS"/>
    <bpmn:exclusiveGateway id="GA01" name="GA-01 Canal"/>
    <bpmn:userTask id="TA01" name="TA-01 Presentar PQRS por formulario web">
      <bpmn:documentation>Formulario web</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="TA02" name="TA-02 Enviar PQRS por correo electrónico">
      <bpmn:documentation>Correo electrónico</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:manualTask id="TA03" name="TA-03 Presentar PQRS en ventanilla">
      <bpmn:documentation>Atención presencial</bpmn:documentation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GA01m" name=""/>
    <bpmn:manualTask id="TA15" name="TA-15 Recibir la respuesta"/>
    <bpmn:endEvent id="E_c" name="Respuesta recibida"/>
    <bpmn:sequenceFlow id="SF01" sourceRef="S_c" targetRef="GA01"/>
    <bpmn:sequenceFlow id="SF02" sourceRef="GA01" targetRef="TA01"/>
    <bpmn:sequenceFlow id="SF03" sourceRef="GA01" targetRef="TA02"/>
    <bpmn:sequenceFlow id="SF04" sourceRef="GA01" targetRef="TA03"/>
    <bpmn:sequenceFlow id="SF05" sourceRef="TA01" targetRef="GA01m"/>
    <bpmn:sequenceFlow id="SF06" sourceRef="TA02" targetRef="GA01m"/>
    <bpmn:sequenceFlow id="SF07" sourceRef="TA03" targetRef="GA01m"/>
    <bpmn:sequenceFlow id="SF08" sourceRef="GA01m" targetRef="TA15"/>
    <bpmn:sequenceFlow id="SF09" sourceRef="TA15" targetRef="E_c"/>
  </bpmn:process>
  <bpmn:process id="Proc_Alc" isExecutable="false" name="Alcaldía de Villa Serena">
    <bpmn:laneSet id="LaneSet_Proc_Alc">
      <bpmn:lane id="Lane_Rad" name="Radicador">
        <bpmn:flowNodeRef>TA05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GRm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_r</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Jef" name="Jefe de dependencia">
        <bpmn:flowNodeRef>TA09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GA02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Fun" name="Funcionario responsable">
        <bpmn:flowNodeRef>TA12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA13</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:manualTask id="TA05" name="TA-05 Revisar buzón de correo y formularios recibidos">
      <bpmn:documentation>Revisión periódica del buzón</bpmn:documentation>
    </bpmn:manualTask>
    <bpmn:manualTask id="TA04" name="TA-04 Recibir PQRS en ventanilla">
      <bpmn:documentation>Papel</bpmn:documentation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GRm" name=""/>
    <bpmn:manualTask id="TA06" name="TA-06 Registrar PQRS en planilla y asignar radicado">
      <bpmn:documentation>Planilla (hoja de cálculo); sin verificación de duplicados</bpmn:documentation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="M2" name=""/>
    <bpmn:manualTask id="TA07" name="TA-07 Decidir tema y dependencia según criterio personal"/>
    <bpmn:manualTask id="TA08" name="TA-08 Reenviar el caso a la dependencia"/>
    <bpmn:manualTask id="TA14" name="TA-14 Actualizar planilla y cerrar el caso"/>
    <bpmn:endEvent id="E_r" name="PQRS respondida y cerrada"/>
    <bpmn:manualTask id="TA09" name="TA-09 Recibir el caso y revisar si le corresponde"/>
    <bpmn:exclusiveGateway id="GA02" name="GA-02 ¿Corresponde a la dependencia?"/>
    <bpmn:manualTask id="TA10" name="TA-10 Devolver o reenviar el caso"/>
    <bpmn:manualTask id="TA11" name="TA-11 Asignar el caso a un funcionario"/>
    <bpmn:manualTask id="TA12" name="TA-12 Elaborar la respuesta"/>
    <bpmn:manualTask id="TA13" name="TA-13 Enviar la respuesta al ciudadano"/>
    <bpmn:textAnnotation id="PD01">
      <bpmn:text>PD-01 Tres canales sin integrar; casos perdidos</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="PD02">
      <bpmn:text>PD-02 Sin verificación de duplicados</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="PD03">
      <bpmn:text>PD-03 Asignación por criterio personal (mal asignados)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="PD04">
      <bpmn:text>PD-04 Devoluciones y reenvíos (reproceso)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="PD05">
      <bpmn:text>PD-05 Asignación informal, sin ver la carga</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="PD06">
      <bpmn:text>PD-06 Sin alertas ni control de plazos</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="PD07">
      <bpmn:text>PD-07 Planilla desactualizada; sin consulta de estado</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="SF13" sourceRef="TA05" targetRef="GRm"/>
    <bpmn:sequenceFlow id="SF14" sourceRef="TA04" targetRef="GRm"/>
    <bpmn:sequenceFlow id="SF15" sourceRef="GRm" targetRef="TA06"/>
