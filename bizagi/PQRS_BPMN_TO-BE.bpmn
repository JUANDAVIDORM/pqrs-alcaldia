<?xml version="1.0" ?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_TOBE" targetNamespace="http://pqrs.villaserena.example/bpmn" name="Proceso TO-BE: gestión de PQRS con BPMS, IA y orquestador (alcaldía ficticia de Villa Serena)">
  <bpmn:collaboration id="Collab_TOBE">
    <bpmn:participant id="Part_Ciu" name="Ciudadano" processRef="Proc_Ciu"/>
    <bpmn:participant id="Part_Alc" name="Alcaldía de Villa Serena (BPMS)" processRef="Proc_Alc"/>
    <bpmn:messageFlow id="MF40" sourceRef="T01" targetRef="S_s"/>
    <bpmn:messageFlow id="MF41" sourceRef="T02" targetRef="S_r"/>
    <bpmn:messageFlow id="MF42" sourceRef="T04" targetRef="EV1"/>
    <bpmn:messageFlow id="MF43" sourceRef="T12" targetRef="EV2"/>
    <bpmn:messageFlow id="MF44" sourceRef="T17" targetRef="T18"/>
    <bpmn:messageFlow id="MF45" sourceRef="T18" targetRef="EV3"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_Ciu" isExecutable="false" name="Ciudadano">
    <bpmn:startEvent id="S_c" name="Necesita presentar una PQRS"/>
    <bpmn:exclusiveGateway id="GC1" name="Canal"/>
    <bpmn:userTask id="T01" name="T-01 Radicar PQRS por formulario web"/>
    <bpmn:manualTask id="T02" name="T-02 Enviar PQRS por correo o acudir a ventanilla"/>
    <bpmn:exclusiveGateway id="GC2" name=""/>
    <bpmn:intermediateCatchEvent id="EV1" name="Recibe número de radicado">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="EV2" name="Recibe la respuesta">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="E_c" name="PQRS respondida"/>
    <bpmn:startEvent id="S_c2" name="Quiere conocer el estado"/>
    <bpmn:userTask id="T17" name="T-17 Consultar estado con el número de radicado"/>
    <bpmn:intermediateCatchEvent id="EV3" name="Recibe el estado">
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="E_c2" name=""/>
    <bpmn:sequenceFlow id="SF01" sourceRef="S_c" targetRef="GC1"/>
    <bpmn:sequenceFlow id="SF02" sourceRef="GC1" targetRef="T01"/>
    <bpmn:sequenceFlow id="SF03" sourceRef="GC1" targetRef="T02"/>
    <bpmn:sequenceFlow id="SF04" sourceRef="T01" targetRef="GC2"/>
    <bpmn:sequenceFlow id="SF05" sourceRef="T02" targetRef="GC2"/>
    <bpmn:sequenceFlow id="SF06" sourceRef="GC2" targetRef="EV1"/>
    <bpmn:sequenceFlow id="SF07" sourceRef="EV1" targetRef="EV2"/>
    <bpmn:sequenceFlow id="SF08" sourceRef="EV2" targetRef="E_c"/>
    <bpmn:sequenceFlow id="SF09" sourceRef="S_c2" targetRef="T17"/>
    <bpmn:sequenceFlow id="SF10" sourceRef="T17" targetRef="EV3"/>
    <bpmn:sequenceFlow id="SF11" sourceRef="EV3" targetRef="E_c2"/>
  </bpmn:process>
  <bpmn:process id="Proc_Alc" isExecutable="false" name="Alcaldía de Villa Serena (BPMS)">
    <bpmn:laneSet id="LaneSet_Proc_Alc">
      <bpmn:lane id="L_Rad" name="Radicador">
        <bpmn:flowNodeRef>S_r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GD2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Bpm" name="BPMS: flujo (orquestador e IA)">
        <bpmn:flowNodeRef>S_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GD1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GM2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GM3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_t</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T18</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Fun" name="Funcionario responsable">
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B70</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B90</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B100</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Pla" name="BPMS: control de plazos">
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_v</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Jef" name="Jefe de dependencia">
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_j</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_r" name="PQRS recibida por correo o ventanilla">
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:userTask id="T03" name="T-03 Registrar PQRS en el sistema"/>
    <bpmn:userTask id="T06" name="T-06 Confirmar o descartar posible duplicado"/>
    <bpmn:exclusiveGateway id="GD2" name="¿Es duplicado?"/>
    <bpmn:userTask id="T09" name="T-09 Revisar y confirmar la clasificación"/>
    <bpmn:startEvent id="S_s" name="PQRS web recibida">
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GJ" name=""/>
    <bpmn:serviceTask id="T04" name="T-04 Generar radicado y notificar al ciudadano"/>
    <bpmn:serviceTask id="T05" name="T-05 Verificar posibles duplicados (orquestador)"/>
    <bpmn:exclusiveGateway id="GD1" name="¿Posible duplicado?"/>
    <bpmn:serviceTask id="T07" name="T-07 Vincular al caso original y notificar"/>
    <bpmn:endEvent id="E_d" name="Caso vinculado al original"/>
    <bpmn:exclusiveGateway id="GM2" name=""/>
    <bpmn:serviceTask id="T08" name="T-08 Clasificar tema y sugerir dependencia (IA)"/>
    <bpmn:exclusiveGateway id="GC" name="¿Confianza ≥ 0,70?"/>
    <bpmn:exclusiveGateway id="GM3" name=""/>
    <bpmn:serviceTask id="T10" name="T-10 Asignar al funcionario y notificarlo"/>
    <bpmn:serviceTask id="T12" name="T-12 Cerrar el caso y notificar al ciudadano"/>
    <bpmn:endEvent id="E_t" name="PQRS cerrada"/>
    <bpmn:serviceTask id="T18" name="T-18 Mostrar estado e historial del caso"/>
    <bpmn:userTask id="T11" name="T-11 Elaborar y enviar la respuesta"/>
    <bpmn:boundaryEvent id="B70" name="70 % del plazo" attachedToRef="T11" cancelActivity="false">
      <bpmn:documentation>Temporizador no interruptor al 70 % del plazo (10,5 días hábiles; supuestos S-05 y S-06)</bpmn:documentation>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10DT12H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B90" name="90 % del plazo" attachedToRef="T11" cancelActivity="false">
      <bpmn:documentation>Temporizador no interruptor al 90 % del plazo (13,5 días hábiles)</bpmn:documentation>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P13DT12H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B100" name="100 % del plazo" attachedToRef="T11" cancelActivity="false">
      <bpmn:documentation>Temporizador no interruptor al vencimiento (15 días hábiles)</bpmn:documentation>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="T13" name="T-13 Alertar al funcionario (70 % del plazo)"/>
    <bpmn:endEvent id="E_a" name="Alerta enviada"/>
    <bpmn:serviceTask id="T14" name="T-14 Escalar alerta al jefe (90 % del plazo)"/>
    <bpmn:serviceTask id="T16" name="T-16 Marcar vencido y notificar al jefe (100 %)"/>
    <bpmn:endEvent id="E_v" name="Caso vencido registrado"/>
    <bpmn:userTask id="T15" name="T-15 Priorizar o reasignar el caso"/>
    <bpmn:endEvent id="E_j" name="Acción del jefe registrada"/>
    <bpmn:sequenceFlow id="SF12" sourceRef="S_r" targetRef="T03"/>
    <bpmn:sequenceFlow id="SF13" sourceRef="T03" targetRef="GJ"/>
    <bpmn:sequenceFlow id="SF14" sourceRef="S_s" targetRef="GJ"/>
    <bpmn:sequenceFlow id="SF15" sourceRef="GJ" targetRef="T04"/>
    <bpmn:sequenceFlow id="SF16" sourceRef="T04" targetRef="T05"/>
    <bpmn:sequenceFlow id="SF17" sourceRef="T05" targetRef="GD1"/>
    <bpmn:sequenceFlow id="SF18" sourceRef="GD1" targetRef="T06" name="Sí"/>
    <bpmn:sequenceFlow id="SF19" sourceRef="T06" targetRef="GD2"/>
    <bpmn:sequenceFlow id="SF20" sourceRef="GD2" targetRef="T07" name="Sí"/>
    <bpmn:sequenceFlow id="SF21" sourceRef="T07" targetRef="E_d"/>
    <bpmn:sequenceFlow id="SF22" sourceRef="GD2" targetRef="GM2" name="No"/>
    <bpmn:sequenceFlow id="SF23" sourceRef="GD1" targetRef="GM2" name="No"/>
    <bpmn:sequenceFlow id="SF24" sourceRef="GM2" targetRef="T08"/>
    <bpmn:sequenceFlow id="SF25" sourceRef="T08" targetRef="GC"/>
    <bpmn:sequenceFlow id="SF26" sourceRef="GC" targetRef="GM3" name="Sí"/>
    <bpmn:sequenceFlow id="SF27" sourceRef="GC" targetRef="T09" name="No"/>
    <bpmn:sequenceFlow id="SF28" sourceRef="T09" targetRef="GM3"/>
    <bpmn:sequenceFlow id="SF29" sourceRef="GM3" targetRef="T10"/>
    <bpmn:sequenceFlow id="SF30" sourceRef="T10" targetRef="T11"/>
    <bpmn:sequenceFlow id="SF31" sourceRef="T11" targetRef="T12"/>
    <bpmn:sequenceFlow id="SF32" sourceRef="T12" targetRef="E_t"/>
    <bpmn:sequenceFlow id="SF33" sourceRef="B70" targetRef="T13"/>
    <bpmn:sequenceFlow id="SF34" sourceRef="B90" targetRef="T14"/>
    <bpmn:sequenceFlow id="SF35" sourceRef="B100" targetRef="T16"/>
    <bpmn:sequenceFlow id="SF36" sourceRef="T13" targetRef="E_a"/>
    <bpmn:sequenceFlow id="SF37" sourceRef="T14" targetRef="T15"/>
    <bpmn:sequenceFlow id="SF38" sourceRef="T15" targetRef="E_j"/>
    <bpmn:sequenceFlow id="SF39" sourceRef="T16" targetRef="E_v"/>
  </bpmn:process>
